# Overleaf Git Authentication Token
# Generate in Overleaf -> Account Settings -> Git Integration -> Create Token
OVERLEAF_GIT_TOKEN=olp_your_git_token_here

# Optional: Default Overleaf Project ID (from https://www.overleaf.com/project/<PROJECT_ID>)
OVERLEAF_PROJECT_ID=

# Optional: Multiple named projects as JSON or comma-separated alias=project_id pairs
# Example: paper1=64a1b2c3d4e5f6,thesis=65b2c3d4e5f6a7
OVERLEAF_PROJECTS=

# Optional: Overleaf Git base URL (defaults to https://git.overleaf.com)
OVERLEAF_GIT_BASE_URL=https://git.overleaf.com

# Optional: Directory where Overleaf Git repositories are cached locally
OVERLEAF_WORKSPACE_DIR=./.overleaf_workspace

# Optional: Git commit author details for changes pushed from MCP
OVERLEAF_GIT_AUTHOR_NAME=Overleaf MCP Assistant
OVERLEAF_GIT_AUTHOR_EMAIL=mcp@overleaf.local

# Server Transport Settings (for remote HTTP/SSE deployment)
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
# Optional Bearer API key to protect remote SSE / Streamable HTTP endpoints
MCP_API_KEY=
